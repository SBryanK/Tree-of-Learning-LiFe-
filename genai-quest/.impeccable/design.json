  "narrative": {
    "northStar": "The Study Desk Atlas",
    "overview": "A pale blue study desk pairs deep teal navigation with mint diagrams and amber actions. The bilingual learning atlas supports reading and operating: clear explanations, visible controls, connected concepts and evidence of practice. System type and open rows keep a content-heavy workspace calm and readable.",
    "keyCharacteristics": [
      "Pale working surface and a persistent teal anchor.",
      "Open learning rows with restrained tonal panels.",
      "Readable diagrams and explicit learning states."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Pair learning states with words; color alone does not establish mastery or course coverage.",
        "section": "colors"
      },
      {
        "name": "The Open Row Rule",
        "body": "Keep repeated lessons, modules, notes and review items on divided rows; reserve filled containers for grouped work, feedback and diagrams.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep bilingual explanations readable with the shared system font and generous paragraph spacing.",
      "**Do** retain visible keyboard focus and the map's scrolling canvas plus list alternative.",
      "**Do** label learning evidence and incomplete source coverage explicitly."
    ],
    "donts": [
      "**Don't** replace open repeated rows with layers of filled cards.",
      "**Don't** shrink the mobile map to fit the viewport at the expense of readable labels.",
      "**Don't** present activity XP, a provisional schedule or mapped concepts as proof of exam readiness."
    ]
  }
}
